# Soft-launch checkout is owned by the server (/api/create-checkout).
# Without a usable Stripe secret (sk_test_… / sk_live_), the API returns demo mode.
# Client Payment Links are not used.

# --- Server (Vercel env — never VITE_ / never commit secrets) ---
# Prefer TEST mode first (sk_test_… / whsec_…), then live (sk_live_…).
# MUST be secret key sk_test_… — never pk_test_ / pk_live_ (publishable) in STRIPE_SECRET_KEY.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Webhook endpoint (this project production host): https://weweb-weld.vercel.app/api/stripe-webhook
# Do not use weweb-hh-7.vercel.app for webhooks/SEO (same app, but X-Robots-Tag: noindex).
# Webhook endpoint: https://<host>/api/stripe-webhook
# Events: checkout.session.completed, invoice.paid, invoice.payment_failed,
#         customer.subscription.updated, customer.subscription.deleted
#
# Optional Dashboard Price IDs (EUR). When set, Checkout uses price_… instead of price_data.
# Recurring Prices required for subscription mode (retainers / VPS):
# STRIPE_PRICE_WEB_DEVELOPMENT_LANDING=price_...
# STRIPE_PRICE_DIGITAL_MARKETING_AUDIT=price_...
# STRIPE_PRICE_DIGITAL_MARKETING_RETAINER=price_...   # recurring monthly
# STRIPE_PRICE_DIGITAL_MARKETING_SEA=price_...        # recurring monthly (SEA Start, limited hours)
# STRIPE_PRICE_DIGITAL_MARKETING_SEO_PFLEGE=price_... # recurring monthly (SEO Care)
# STRIPE_PRICE_DIGITAL_MARKETING_SOCIAL=price_...     # recurring monthly (Social)
# STRIPE_PRICE_WEB_HOSTING_VPS=price_...              # recurring monthly
# STRIPE_PRICE_WEB_HOSTING_CARE=price_...             # recurring monthly (Care €59)
# STRIPE_PRICE_WEB_HOSTING_CARE_PRO=price_...         # recurring monthly (Care Pro €99)
# STRIPE_PRICE_WEB_DEVELOPMENT_ADDON_CMS=price_...
#
# Customer Portal: enable in Stripe Dashboard → Settings → Billing → Customer portal
# API: POST /api/create-portal-session { "email": "…" }
#
# Optional durable webhook idempotency (Vercel KV or Upstash Redis REST):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# — or —
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# --- Ops checklist (Stripe TEST first; do not use live MCP account for soft-launch) ---
# 1) Create Stripe test Products/Prices (EUR) matching catalog package ids
# 2) Set Vercel env: STRIPE_SECRET_KEY=sk_test_… STRIPE_WEBHOOK_SECRET=whsec_…
# 3) Set STRIPE_PRICE_* for recurring packages (retainer, VPS) before subscription Checkout
# 4) Dashboard → Developers → Webhooks → https://weweb-weld.vercel.app/api/stripe-webhook
#    Events: checkout.session.completed, invoice.paid, invoice.payment_failed,
#            customer.subscription.updated, customer.subscription.deleted
# 5) Enable Customer Portal (Billing → Customer portal)
# 6) Optional: attach Vercel KV / Upstash and set REST URL+TOKEN
# 7) Business gate: approve catalog prices/terms before live keys
